generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model FuenteCompetencial {
  id          Int      @id @default(autoincrement())
  nombre      String
  organismo   String?
  referencia  String?
  descripcion String?
  creadaEn    DateTime @default(now())

  competencias Competencia[]
}

model Competencia {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  creadaEn    DateTime @default(now())

  fuenteId Int?
  fuente   FuenteCompetencial? @relation(fields: [fuenteId], references: [id], onDelete: Restrict)

  dimensiones Dimension[]

  // Relacion antigua, conservada temporalmente
  indicadores Indicador[]
}

model Dimension {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  orden       Int      @default(0)
  creadaEn    DateTime @default(now())

  competenciaId Int
  competencia   Competencia @relation(fields: [competenciaId], references: [id], onDelete: Restrict)

  indicadores Indicador[]

  @@unique([competenciaId, nombre])
}

model Indicador {
  id          Int      @id @default(autoincrement())
  descripcion String
  creadaEn    DateTime @default(now())

  // Relacion antigua, conservada durante la migracion
  competenciaId Int
  competencia   Competencia @relation(fields: [competenciaId], references: [id], onDelete: Cascade)

  // Nueva relacion, opcional durante la transicion
  dimensionId           Int?
  dimension             Dimension?              @relation(fields: [dimensionId], references: [id], onDelete: Restrict)
  selecciones           IndicadorSeleccionado[]
  valoraciones          Valoracion[]
  planesRefuerzo        PlanRefuerzo[]
  rubricas              RubricaIndicador[]
  criteriosCurriculares IndicadorCriterio[]
}

model ConfiguracionSeguimiento {
  id            Int      @id @default(autoincrement())
  nombre        String
  descripcion   String?
  creadaEn      DateTime @default(now())
  actualizadaEn DateTime @updatedAt

  imparticionId Int?
  imparticion   ImparticionModulo? @relation(fields: [imparticionId], references: [id], onDelete: Restrict)

  indicadores IndicadorSeleccionado[]
}

model IndicadorSeleccionado {
  id              Int @id @default(autoincrement())
  configuracionId Int
  indicadorId     Int

  configuracion ConfiguracionSeguimiento @relation(fields: [configuracionId], references: [id], onDelete: Cascade)
  indicador     Indicador                @relation(fields: [indicadorId], references: [id], onDelete: Restrict)

  @@unique([configuracionId, indicadorId])
}

model Grupo {
  ciclo       String?
  id          Int      @id @default(autoincrement())
  nombre      String
  curso       String
  descripcion String?
  creadoEn    DateTime @default(now())

  matriculas    Matricula[]
  imparticiones ImparticionModulo[]
}

model Estudiante {
  id       Int      @id @default(autoincrement())
  codigo   String   @unique
  nombre   String
  creadoEn DateTime @default(now())

  matriculas     Matricula[]
  valoraciones   Valoracion[]
  planesRefuerzo PlanRefuerzo[]
  evidencias     Evidencia[]
}

model Matricula {
  id           Int      @id @default(autoincrement())
  estudianteId Int
  grupoId      Int
  fechaAlta    DateTime @default(now())
  fechaBaja    DateTime?

  estudiante Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Restrict)
  grupo      Grupo      @relation(fields: [grupoId], references: [id], onDelete: Restrict)

  @@unique([estudianteId, grupoId])
}

model ImparticionModulo {
  id           Int      @id @default(autoincrement())
  nombreModulo String
  curso        String
  grupoId      Int
  creadoEn     DateTime @default(now())

  grupo          Grupo          @relation(fields: [grupoId], references: [id], onDelete: Restrict)
  valoraciones   Valoracion[]
  planesRefuerzo PlanRefuerzo[]
  actividades    Actividad[]
  moduloId       Int?

  modulo          ModuloProfesional?         @relation(fields: [moduloId], references: [id], onDelete: Restrict)
  configuraciones ConfiguracionSeguimiento[]
  hitosRevision HitoRevision[]
}

model HitoRevision {
  id            Int      @id @default(autoincrement())
  imparticionId Int
  fecha         DateTime @db.Date
  titulo        String
  nota          String   @default("")
  revisado      Boolean  @default(false)

  imparticion ImparticionModulo @relation(fields: [imparticionId], references: [id], onDelete: Restrict)

  @@index([imparticionId, fecha])
}

model Valoracion {
  id            Int      @id @default(autoincrement())
  estudianteId  Int
  indicadorId   Int
  imparticionId Int
  nivel         Int
  observacion   String?
  fecha         DateTime @default(now())

  // Trazabilidad de la evaluación
  rubricaId          Int?
  descriptorAplicado String?

  estudiante  Estudiante        @relation(fields: [estudianteId], references: [id], onDelete: Restrict)
  indicador   Indicador         @relation(fields: [indicadorId], references: [id], onDelete: Restrict)
  imparticion ImparticionModulo @relation(fields: [imparticionId], references: [id], onDelete: Restrict)

  rubrica     Rubrica? @relation(fields: [rubricaId], references: [id], onDelete: Restrict)
  evidenciaId Int?

  evidencia Evidencia? @relation(fields: [evidenciaId], references: [id], onDelete: Restrict)

  @@index([estudianteId, indicadorId, fecha])
  @@index([imparticionId, fecha])
  @@index([rubricaId])
}

model PlanRefuerzo {
  id            Int @id @default(autoincrement())
  estudianteId  Int
  indicadorId   Int
  imparticionId Int

  objetivo      String
  descripcion   String
  fechaInicio   DateTime  @default(now())
  fechaRevision DateTime?
  estado        String    @default("pendiente")

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  estudiante  Estudiante        @relation(fields: [estudianteId], references: [id], onDelete: Restrict)
  indicador   Indicador         @relation(fields: [indicadorId], references: [id], onDelete: Restrict)
  imparticion ImparticionModulo @relation(fields: [imparticionId], references: [id], onDelete: Restrict)

  @@index([estudianteId, indicadorId])
  @@index([imparticionId, estado])
}

model Rubrica {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  creadaEn    DateTime @default(now())

  niveles      NivelDesempeno[]
  indicadores  RubricaIndicador[]
  valoraciones Valoracion[]
}

model NivelDesempeno {
  id          Int    @id @default(autoincrement())
  rubricaId   Int
  valor       Int
  descripcion String

  rubrica Rubrica @relation(fields: [rubricaId], references: [id], onDelete: Cascade)

  @@unique([rubricaId, valor])
}

model RubricaIndicador {
  id          Int @id @default(autoincrement())
  rubricaId   Int
  indicadorId Int

  rubrica Rubrica @relation(fields: [rubricaId], references: [id], onDelete: Cascade)

  indicador Indicador @relation(fields: [indicadorId], references: [id], onDelete: Restrict)

  @@unique([rubricaId, indicadorId])
}

model Actividad {
  id             Int       @id @default(autoincrement())
  imparticionId  Int
  titulo         String
  descripcion    String?
  fechaPropuesta DateTime  @default(now())
  fechaEntrega   DateTime?

  imparticion ImparticionModulo @relation(fields: [imparticionId], references: [id], onDelete: Restrict)

  evidencias Evidencia[]

  @@index([imparticionId])
}

model Evidencia {
  id            Int      @id @default(autoincrement())
  actividadId   Int
  estudianteId  Int
  descripcion   String
  referencia    String?
  fechaRegistro DateTime @default(now())

  actividad Actividad @relation(fields: [actividadId], references: [id], onDelete: Restrict)

  estudiante Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Restrict)

  valoraciones Valoracion[]

  @@index([actividadId, estudianteId])
}

model ModuloProfesional {
  id          Int     @id @default(autoincrement())
  codigo      String  @unique
  nombre      String
  descripcion String?

  resultados    ResultadoAprendizaje[]
  imparticiones ImparticionModulo[]
}

model ResultadoAprendizaje {
  id       Int    @id @default(autoincrement())
  moduloId Int
  codigo   String
  texto    String

  modulo ModuloProfesional @relation(fields: [moduloId], references: [id], onDelete: Restrict)

  criterios CriterioEvaluacion[]

  @@unique([moduloId, codigo])
}

model CriterioEvaluacion {
  id     Int    @id @default(autoincrement())
  raId   Int
  codigo String
  texto  String

  resultado ResultadoAprendizaje @relation(fields: [raId], references: [id], onDelete: Restrict)

  indicadores IndicadorCriterio[]

  @@unique([raId, codigo])
}

model IndicadorCriterio {
  id          Int @id @default(autoincrement())
  indicadorId Int
  criterioId  Int

  indicador Indicador @relation(fields: [indicadorId], references: [id], onDelete: Cascade)

  criterio CriterioEvaluacion @relation(fields: [criterioId], references: [id], onDelete: Cascade)

  @@unique([indicadorId, criterioId])
}
